[sub_resource type="GDScript" id="39"]
script/source = "extends AudioStreamPlayer

@export var maxVolume = 2


func _ready():
	set_process(false)
	await get_tree().create_timer(0.5, false).timeout
	play()
	set_process(true)


func _process(delta):
	if (volume_db < maxVolume):
		volume_db += delta
	else:
		set_process(false)
"

