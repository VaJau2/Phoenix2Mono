[sub_resource type="GDScript" id="83"]
script/source = "extends AudioStreamPlayer

@export var maxVolume = 2
var startTimer = 2
var onetimePlay = false

func _process(delta):
	if (startTimer > 0):
		startTimer -= delta
	else:
		if (!onetimePlay):
			play()
			onetimePlay = true
		
		if (volume_db < maxVolume):
			volume_db += delta
		else:
			set_process(false)
"

