[layer_names]

3d_render/layer_2="First Person"
3d_render/layer_3="Third Person"
3d_physics/layer_1="Default"
3d_physics/layer_2="Ragdoll & Floor"
3d_physics/layer_3="Interactive"
3d_physics/layer_4="Exit"
3d_physics/layer_5="Door"
3d_physics/layer_6="Camera"

[locale]

fallback="ru_RU"

[logging]

file_logging/enable_file_logging=true

[mono]

project/assembly_name="Phoenix 2 Mono"
profiler/enabled=true
export/include_scripts_content=true
export/aot/use_interpreter=false

[navigation]

3d/default_cell_size=0.3
3d/default_cell_height=0.2

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
environment/defaults/default_environment="res://default_env.tres"
vram_compression/import_etc=true
