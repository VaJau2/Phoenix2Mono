; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Phoenix 2 Mono"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/textures/black_splash_screen.png"
config/icon="res://assets/textures/interface/icons/icon.png"
config/macos_native_icon="res://assets/textures/interface/icons/icon.png"
config/windows_native_icon="res://icon.ico"

[audio]

buses/default_bus_layout="uid://bmjocdetbscip"

[display]

window/size/viewport_width=1024
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Phoenix 2 Mono"

[editor]

convert_text_resources_to_binary_on_export=true

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}
mp3={
"loop": false,
"loop_offset": 0
}

