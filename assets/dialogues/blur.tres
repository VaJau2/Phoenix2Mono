[gd_resource type="ShaderMaterial" format=3 uid="uid://dydffc5w3lmpo"]

[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

uniform float blur_amount : hint_range(0, 5);

void fragment() {
	// альфа копии экрана после 3D-рендера в Godot 4 равна 0 — берём только цвет, фон непрозрачный
	COLOR = vec4(textureLod(SCREEN_TEXTURE, SCREEN_UV, blur_amount).rgb, 1.0);
}"

[resource]
shader = SubResource("1")
shader_parameter/blur_amount = 2.0
